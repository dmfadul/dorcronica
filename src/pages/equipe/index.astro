---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { credencial, nomeCompleto } from '../../lib/format';

/* Pronto para crescer: cada profissional novo é um .md em src/content/profissionais/. */
const equipe = (await getCollection('profissionais')).sort((a, b) => a.data.ordem - b.data.ordem);
const trilha = [{ nome: 'Início', href: '/' }, { nome: 'Equipe', href: '/equipe/' }];
---
<BaseLayout titulo="Equipe" descricao="Profissionais responsáveis pelo cuidado.">
  <PageIntro trilha={trilha} eyebrow="Quem cuida" titulo="Equipe" />
  <section class="section">
    <ul class="container team" role="list">
      {equipe.map((p) => (
        <li>
          <Image src={p.data.foto} alt={p.data.fotoAlt} widths={[320, 560]} sizes="(min-width: 860px) 30vw, 90vw" />
          <h2><a href={`/equipe/${p.id}/`}>{nomeCompleto(p.data)}</a></h2>
          <p class="cred">{credencial(p.data)}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
<style>
  .team { list-style: none; padding: 0; display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  li { position: relative; }
  li :global(img) { aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 15%; background: var(--navy); border-radius: var(--radius); }
  h2 { font-size: var(--step-2); margin: 1rem 0 0.25rem; }
  h2 a { text-decoration: none; }
  h2 a::after { content: ''; position: absolute; inset: 0; }
  .cred { font-size: 0.85rem; color: var(--muted); }
</style>
