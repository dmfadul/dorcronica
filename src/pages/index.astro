---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ConditionIndex from '../components/ConditionIndex.astro';
import ArticleList from '../components/ArticleList.astro';
import ContactBlock from '../components/ContactBlock.astro';
import BodyMap from '../components/BodyMap.astro';
import PainTypes from '../components/PainTypes.astro';
import LiteYouTube from '../components/LiteYouTube.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappPrincipal } from '../config/site';
import { credencial, nomeCompleto, linkWhatsapp, especialidadeTexto, dataLonga } from '../lib/format';
import { clinica, physician, grafo, faqPage } from '../lib/jsonld';

const rt = (await getEntry('profissionais', site.responsavelTecnico))!;
const condicoes = (await getCollection('condicoes')).sort((a, b) => a.data.ordem - b.data.ordem);
const tratamentos = (await getCollection('tratamentos')).sort((a, b) => a.data.ordem - b.data.ordem);
const etapas = ['Avaliação', 'Tratamento clínico', 'Procedimento', 'Acompanhamento'] as const;
const artigos = (await getCollection('artigos', (a) => !a.data.rascunho))
  .sort((a, b) => b.data.publicadoEm.valueOf() - a.data.publicadoEm.valueOf())
  .slice(0, site.recursos.artigosNaHome);
const depoimentos = site.recursos.depoimentos ? await getCollection('depoimentos', (d) => d.data.autorizado) : [];
const faq = (await getCollection('faq', (f) => f.data.destaque)).sort((a, b) => a.data.ordem - b.data.ordem).map((f) => f.data);
const [podcast] = (await getCollection('midia')).sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf());
const unidades = await getCollection('unidades');
const wa = linkWhatsapp(whatsappPrincipal.numero, site.contato.mensagemWhatsapp);
const [citacaoPrincipal, ...outrasCitacoes] = rt.data.citacoes;

const jsonld = grafo(clinica(Astro.site!, unidades, rt), physician(rt, Astro.site!), faqPage(faq));
---
<BaseLayout titulo={`${site.nome} — ${site.servico} em ${site.cidade}`} descricao={site.descricao} jsonld={jsonld}>
  <!-- 1. Abertura -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{site.servico} · {site.cidade}</p>
        <h1>A dor que não passa é uma doença. <em>E merece tratamento próprio.</em></h1>
        <p class="lead">
          Diagnóstico e tratamento da dor crônica — da lombalgia à dor neuropática, da enxaqueca à fibromialgia —
          com medicação dirigida, procedimentos minimamente invasivos e acompanhamento multidisciplinar.
        </p>
        <div class="cta-row">
          <a class="btn" href={wa} rel="noopener" data-evento="whatsapp_hero"><Icon nome="whatsapp" /> Agendar consulta</a>
          <a class="btn btn--ghost" href="#onde-doi">Onde dói? Comece por aqui</a>
        </div>
      </div>
      <figure class="hero-photo">
        <Image src={rt.data.foto} alt={rt.data.fotoAlt} widths={[420, 640, 900]} sizes="(min-width: 960px) 38vw, 90vw" loading="eager" fetchpriority="high" />
        <figcaption>
          <strong>{nomeCompleto(rt.data)}</strong>
          <span>{especialidadeTexto(rt.data)}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 2. Credenciais -->
  <section class="creds" aria-label="Atuação do médico">
    <div class="container">
      <ul role="list">
        {rt.data.vinculos.map((v) => (
          <li><span class="cargo">{v.cargo}</span><span class="inst">{v.instituicao}</span></li>
        ))}
      </ul>
      <p class="reg">{nomeCompleto(rt.data)} · {credencial(rt.data)}</p>
    </div>
  </section>

  <!-- 3. Onde dói -->
  <section class="section" id="onde-doi">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Comece por aqui</p>
          <h2>Onde dói?</h2>
        </div>
        <p class="muted">Marque no corpo onde você sente dor e veja as condições que costumam envolver essas regiões. Depois, leve a seleção para a consulta.</p>
      </div>
      <BodyMap compacto idBase="mapa-home" />
    </div>
  </section>

  <!-- 4. Os tipos de dor -->
  <section class="section section--navy">
    <div class="container types-grid">
      <div class="types-intro">
        <p class="eyebrow">Compreender para tratar</p>
        <blockquote>
          <p>“Uma experiência sensorial e emocional desagradável, associada ou semelhante a uma lesão tecidual real ou potencial.”</p>
          <footer>Definição de dor da IASP — Associação Internacional para o Estudo da Dor</footer>
        </blockquote>
        <p class="ti-body">Nem toda dor é igual. O mecanismo por trás dela muda o tratamento — e é a primeira coisa que a consulta procura entender.</p>
      </div>
      <PainTypes />
    </div>
  </section>

  <!-- 5. Condições -->
  <section class="section" id="condicoes">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">O que tratamos</p>
          <h2>Condições que acompanhamos</h2>
        </div>
        <a class="link-arrow" href="/condicoes/">Ver todas, com detalhes</a>
      </div>
      <ConditionIndex condicoes={condicoes} colunas />
    </div>
  </section>

  <!-- 6. Como cuidamos -->
  <section class="section section--deep" id="tratamentos">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Como cuidamos</p>
          <h2>Do diagnóstico ao acompanhamento</h2>
        </div>
        <p class="muted">Nem todo paciente passa por todas as etapas. Procedimentos são indicados caso a caso.</p>
      </div>
      <ol class="journey" role="list">
        {etapas.map((e, i) => (
          <li>
            <span class="step">{String(i + 1).padStart(2, '0')}</span>
            <h3>{e}</h3>
            <ul role="list">
              {tratamentos.filter((t) => t.data.etapa === e).map((t) => (
                <li><a href={`/tratamentos/${t.id}/`}>{t.data.titulo}</a></li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
      <p class="journey-note">Procedimentos minimamente invasivos, guiados por ultrassom ou fluoroscopia, com anestesia local e alta no mesmo dia na maioria dos casos.</p>
    </div>
  </section>

  <!-- 7. Na voz do médico -->
  {citacaoPrincipal && (
    <section class="section voice">
      <div class="container voice-grid">
        <div>
          <p class="eyebrow">Na voz do médico</p>
          <blockquote class="big-quote">
            <p>{citacaoPrincipal.texto}</p>
            <footer>{nomeCompleto(rt.data)} — {citacaoPrincipal.fonte}</footer>
          </blockquote>
          <ul class="more-quotes" role="list">
            {outrasCitacoes.map((c) => (
              <li><p>“{c.texto}”</p><span>{c.fonte}</span></li>
            ))}
          </ul>
        </div>
        {podcast?.data.youtubeId && (
          <div class="pod">
            <LiteYouTube id={podcast.data.youtubeId} titulo={podcast.data.titulo} />
            <p class="pod-meta">{podcast.data.formato} · {podcast.data.veiculo} · {dataLonga(podcast.data.data)}{podcast.data.duracao && ` · ${podcast.data.duracao}`}</p>
            <h3>{podcast.data.titulo}</h3>
            <p class="muted">{podcast.data.resumo}</p>
            <a class="link-arrow" href="/na-midia/">Tópicos do episódio</a>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- 8. Ferramentas -->
  <section class="section section--deep tools">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Para chegar preparado</p>
          <h2>Ferramentas para pacientes</h2>
        </div>
        <p class="muted">Funcionam no seu navegador. Nada do que você preencher é enviado para lugar nenhum.</p>
      </div>
      <ol class="tool-list" role="list">
        <li>
          <a href="/preparar-consulta/">
            <span class="t-n">A</span>
            <span class="t-title">Preparar minha consulta</span>
            <span class="t-desc">Responda em 5 minutos o que o médico vai perguntar e imprima um resumo de uma página.</span>
          </a>
        </li>
        <li>
          <a href="/diario-da-dor/">
            <span class="t-n">B</span>
            <span class="t-title">Diário da dor</span>
            <span class="t-desc">Registre a dor dia a dia e leve o gráfico das últimas semanas para a consulta.</span>
          </a>
        </li>
        <li>
          <a href="/primeira-consulta/">
            <span class="t-n">C</span>
            <span class="t-title">Como é a primeira consulta</span>
            <span class="t-desc">O que acontece, o que levar e o que esperar do plano de tratamento.</span>
          </a>
        </li>
      </ol>
    </div>
  </section>

  <!-- 9. Perguntas frequentes -->
  <section class="section">
    <div class="container faq-grid">
      <div>
        <p class="eyebrow">Dúvidas comuns</p>
        <h2>Perguntas frequentes</h2>
        <a class="link-arrow" href="/perguntas-frequentes/">Todas as perguntas</a>
      </div>
      <FaqList itens={faq} />
    </div>
  </section>

  <!-- 10. Depoimento -->
  {depoimentos.length > 0 && (
    <section class="section section--deep testimonials" aria-labelledby="dep-titulo">
      <div class="container">
        <h2 id="dep-titulo" class="eyebrow">O que os pacientes dizem</h2>
        {depoimentos.map((d) => (
          <figure class="quote">
            <blockquote><p>{d.data.texto}</p></blockquote>
            <figcaption>{d.data.autor}{d.data.cidade && `, ${d.data.cidade}`}</figcaption>
          </figure>
        ))}
        <a class="link-arrow" href={site.redes.doctoralia} rel="noopener">Avaliações de pacientes no Doctoralia</a>
      </div>
    </section>
  )}

  <!-- 11. Artigos -->
  {artigos.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">Artigos</p>
            <h2>Entenda melhor a dor</h2>
          </div>
          <a class="link-arrow" href="/artigos/">Todos os artigos</a>
        </div>
        <ArticleList artigos={artigos} />
      </div>
    </section>
  )}

  <!-- 12. Contato -->
  <section class="section section--deep" id="contato">
    <ContactBlock />
  </section>
</BaseLayout>

<style>
  /* Abertura */
  .hero { padding-top: clamp(2.5rem, 2rem + 4vw, 5rem); overflow: hidden; }
  .hero-grid { display: grid; gap: var(--space-4); align-items: end; }
  @media (min-width: 960px) { .hero-grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); } }
  .hero-copy { padding-bottom: var(--space-5); }
  .hero h1 { font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.6rem); max-width: 16ch; line-height: 1.04; }
  .hero h1 em { font-style: italic; color: var(--navy-2); font-weight: 350; }
  .hero .lead { max-width: 52ch; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: var(--space-3); }
  .hero-photo {
    margin: 0; align-self: end; position: relative;
    background: var(--navy); border-radius: var(--radius) var(--radius) 0 0; overflow: hidden; max-height: 620px;
  }
  .hero-photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 12%; }
  .hero-photo figcaption {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 2.5rem 1.25rem 1.1rem;
    background: linear-gradient(to top, rgb(20 37 60 / .92), transparent);
    color: var(--on-navy); display: grid; gap: 0.15rem;
  }
  .hero-photo figcaption strong { font: 500 1.2rem/1.2 var(--font-serif); }
  .hero-photo figcaption span { font-size: 0.82rem; color: var(--on-navy-muted); }
  @media (max-width: 959px) { .hero-copy { padding-bottom: 0; } .hero-photo { aspect-ratio: 4 / 4.3; max-height: 520px; } }

  /* Credenciais */
  .creds { background: var(--navy); color: var(--on-navy); padding-block: var(--space-4) var(--space-3); }
  .creds ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem 2rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .creds li { display: grid; gap: 0.25rem; padding-left: 1rem; border-left: 1px solid rgb(255 255 255 / 0.18); }
  .cargo { font: 400 1.12rem/1.25 var(--font-serif); }
  .inst { font-size: 0.85rem; color: var(--on-navy-muted); }
  .reg { margin: var(--space-3) 0 0; font-size: 0.78rem; letter-spacing: 0.05em; color: var(--gold-on-navy); }

  /* Tipos de dor */
  .types-grid { display: grid; gap: var(--space-4); }
  @media (min-width: 1000px) { .types-grid { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); column-gap: var(--space-5); align-items: start; } }
  .types-intro blockquote { margin: 0 0 var(--space-3); }
  .types-intro blockquote p { font: 400 var(--step-2)/1.3 var(--font-serif); margin-bottom: 0.75rem; }
  .types-intro blockquote footer { font-size: 0.85rem; color: var(--on-navy-muted); }
  .ti-body { color: var(--on-navy-muted); max-width: 46ch; }

  /* Jornada */
  .journey { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  @media (min-width: 900px) { .journey { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .journey > li { padding-top: 1.25rem; border-top: 2px solid var(--ink); }
  .journey > li:not(:first-child) { border-top-color: var(--line); }
  .step { display: block; font: 400 2.2rem/1 var(--font-serif); color: var(--gold); margin-bottom: 0.75rem; }
  .journey h3 { font-size: var(--step-1); font-family: var(--font-sans); font-weight: 650; letter-spacing: 0; }
  .journey ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.45rem; }
  .journey ul a { text-decoration: none; color: var(--ink-soft); }
  .journey ul a:hover { color: var(--ink); text-decoration: underline; }
  .journey-note { margin: var(--space-4) 0 0; color: var(--muted); font-size: 0.92rem; max-width: 70ch; }

  /* Voz do médico */
  .voice-grid { display: grid; gap: var(--space-4); }
  @media (min-width: 1000px) { .voice-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--space-5); align-items: start; } }
  .big-quote { margin: 0 0 var(--space-4); }
  .big-quote p { font: 400 clamp(2rem, 1.4rem + 2.4vw, 3.3rem)/1.08 var(--font-serif); letter-spacing: -0.015em; margin-bottom: 1rem; text-wrap: balance; }
  .big-quote p::before { content: '“'; color: var(--gold); }
  .big-quote p::after { content: '”'; color: var(--gold); }
  .big-quote footer { color: var(--muted); font-size: 0.9rem; }
  .more-quotes { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  .more-quotes li { border-top: 1px solid var(--line); padding-top: 1rem; }
  .more-quotes p { font: 400 var(--step-1)/1.35 var(--font-serif); margin: 0 0 0.3rem; }
  .more-quotes span { font-size: 0.82rem; color: var(--muted); }
  .pod-meta { margin: 1rem 0 0.3rem; font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .pod h3 { font-size: var(--step-2); }

  /* Ferramentas */
  .tool-list { list-style: none; margin: 0; padding: 0; }
  .tool-list li { border-top: 1px solid var(--line); }
  .tool-list li:last-child { border-bottom: 1px solid var(--line); }
  .tool-list a { display: grid; grid-template-columns: 3rem 1fr; gap: 0.25rem 1rem; padding: 1.5rem 0.25rem; text-decoration: none; align-items: baseline; }
  @media (min-width: 900px) { .tool-list a { grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 1.2fr) 2rem; } .tool-list a::after { content: '→'; font-size: 1.4rem; color: var(--muted); transition: transform .2s ease; } .tool-list a:hover::after { transform: translateX(4px); color: var(--ink); } }
  .tool-list a:hover { background: var(--surface); }
  .t-n { font: italic 400 1.6rem/1 var(--font-serif); color: var(--gold); }
  .t-title { font: 400 var(--step-2)/1.15 var(--font-serif); }
  .t-desc { color: var(--ink-soft); grid-column: 2; }
  @media (min-width: 900px) { .t-desc { grid-column: 3; } }

  /* FAQ */
  .faq-grid { display: grid; gap: var(--space-3); }
  @media (min-width: 960px) { .faq-grid { grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); column-gap: var(--space-5); align-items: start; } }

  /* Depoimento */
  .testimonials h2 { font-family: var(--font-sans); }
  .quote { margin: 0 0 var(--space-3); }
  .quote blockquote { margin: 0; }
  .quote blockquote p { font: 400 var(--step-3)/1.2 var(--font-serif); margin-bottom: 1rem; max-width: 26ch; }
  .quote blockquote p::before { content: '“'; color: var(--gold); margin-left: -0.45em; }
  .quote blockquote p::after { content: '”'; color: var(--gold); }
  .quote figcaption { color: var(--muted); }
  .quote figcaption::before { content: '— '; }
</style>
