---
/**
 * "Onde dói?" — mapa do corpo (frente e costas).
 * - Os chips são o controle acessível (botões com aria-pressed); o desenho espelha.
 * - Os resultados são renderizados no servidor (links reais) e o script só filtra
 *   e ordena: funciona offline e sem JS mostra a lista inteira.
 * - Nada é enviado a lugar nenhum.
 */
import { getCollection } from 'astro:content';
import { REGIOES, TIPOS_DE_DOR, type Regiao } from '../lib/regioes';

interface Props { compacto?: boolean; idBase?: string; }
const { compacto = false, idBase = 'mapa' } = Astro.props;

const condicoes = (await getCollection('condicoes')).sort((a, b) => a.data.ordem - b.data.ordem);
const regioes = Object.entries(REGIOES) as [Regiao, string][];
---
<div class:list={['bodymap', { compacto }]} data-bodymap id={idBase}>
  <div class="figure-col">
    <div class="figures" aria-hidden="true">
      <figure>
        <svg viewBox="0 0 200 420" class="body">
          <g class="r" data-r="cabeca"><path d="M78,40 A22,26 0 0 1 122,40 Z" /></g>
          <g class="r" data-r="face"><path d="M78,40 A22,26 0 0 0 122,40 Z" /></g>
          <g class="r" data-r="cervical"><rect x="90" y="64" width="20" height="15" rx="5" /></g>
          <g class="r" data-r="ombro"><ellipse cx="66" cy="90" rx="14" ry="10" /><ellipse cx="134" cy="90" rx="14" ry="10" /></g>
          <g class="r" data-r="torax"><path d="M76,82 C88,78 112,78 124,82 L130,148 L70,148 Z" /></g>
          <g class="r" data-r="abdome-pelve"><path d="M70,150 L130,150 L128,206 C116,216 84,216 72,206 Z" /></g>
          <g class="r" data-r="braco-mao">
            <path d="M54,98 C48,122 46,150 42,176 L38,212 L50,214 L56,178 C60,154 64,126 68,106 Z" />
            <path d="M146,98 C152,122 154,150 158,176 L162,212 L150,214 L144,178 C140,154 136,126 132,106 Z" />
            <ellipse cx="44" cy="227" rx="8" ry="12" /><ellipse cx="156" cy="227" rx="8" ry="12" />
          </g>
          <g class="r" data-r="quadril">
            <path d="M72,208 C84,218 96,218 99,216 L97,294 L77,294 C74,266 72,238 72,208 Z" />
            <path d="M128,208 C116,218 104,218 101,216 L103,294 L123,294 C126,266 128,238 128,208 Z" />
          </g>
          <g class="r" data-r="joelho"><ellipse cx="87" cy="307" rx="11" ry="12" /><ellipse cx="113" cy="307" rx="11" ry="12" /></g>
          <g class="r" data-r="perna-pe">
            <path d="M77,320 L97,320 L94,390 L81,390 Z" /><path d="M103,320 L123,320 L119,390 L106,390 Z" />
            <ellipse cx="86" cy="401" rx="12" ry="6" /><ellipse cx="114" cy="401" rx="12" ry="6" />
          </g>
        </svg>
        <figcaption>Frente</figcaption>
      </figure>
      <figure>
        <svg viewBox="0 0 200 420" class="body">
          <g class="r" data-r="cabeca"><ellipse cx="100" cy="40" rx="22" ry="26" /></g>
          <g class="r" data-r="cervical"><rect x="90" y="64" width="20" height="15" rx="5" /></g>
          <g class="r" data-r="ombro"><ellipse cx="66" cy="90" rx="14" ry="10" /><ellipse cx="134" cy="90" rx="14" ry="10" /></g>
          <g class="r" data-r="costas-alta"><path d="M76,82 C88,78 112,78 124,82 L130,150 L70,150 Z" /></g>
          <g class="r" data-r="lombar"><path d="M70,152 L130,152 L129,198 L71,198 Z" /></g>
          <g class="r" data-r="braco-mao">
            <path d="M54,98 C48,122 46,150 42,176 L38,212 L50,214 L56,178 C60,154 64,126 68,106 Z" />
            <path d="M146,98 C152,122 154,150 158,176 L162,212 L150,214 L144,178 C140,154 136,126 132,106 Z" />
            <ellipse cx="44" cy="227" rx="8" ry="12" /><ellipse cx="156" cy="227" rx="8" ry="12" />
          </g>
          <g class="r" data-r="quadril"><path d="M71,200 L129,200 C130,250 126,278 123,294 L103,294 L101,226 L99,226 L97,294 L77,294 C74,278 70,250 71,200 Z" /></g>
          <g class="r" data-r="joelho"><ellipse cx="87" cy="307" rx="11" ry="12" /><ellipse cx="113" cy="307" rx="11" ry="12" /></g>
          <g class="r" data-r="perna-pe">
            <path d="M77,320 L97,320 L94,390 L81,390 Z" /><path d="M103,320 L123,320 L119,390 L106,390 Z" />
            <ellipse cx="86" cy="401" rx="12" ry="6" /><ellipse cx="114" cy="401" rx="12" ry="6" />
          </g>
        </svg>
        <figcaption>Costas</figcaption>
      </figure>
    </div>
    <p class="hint">Toque no desenho ou escolha abaixo. Pode marcar mais de uma região.</p>
  </div>

  <div class="panel-col">
    <fieldset class="chips">
      <legend>Onde você sente dor?</legend>
      {regioes.map(([id, nome]) => (
        <button type="button" class="chip" data-chip={id} aria-pressed="false">{nome}</button>
      ))}
    </fieldset>

    <div class="results" aria-live="polite">
      <p class="status" data-status>Marque uma ou mais regiões para ver condições que costumam envolvê-las.</p>
      <ol class="list" role="list">
        {condicoes.map((c) => (
          <li data-cond={c.id} data-regioes={c.data.regioes.join(' ')} data-ordem={c.data.ordem}>
            <a href={`/condicoes/${c.id}/`}>
              <span class="c-title">{c.data.curto ?? c.data.titulo}</span>
              <span class="c-type">{TIPOS_DE_DOR[c.data.tipo].nome}</span>
            </a>
            {!compacto && <p>{c.data.resumo}</p>}
          </li>
        ))}
      </ol>
      <button type="button" class="more" data-mais hidden></button>
      <div class="actions" data-actions hidden>
        <a class="btn" href="/preparar-consulta/" data-levar>Levar isso para a consulta</a>
        <button type="button" class="btn btn--ghost" data-limpar>Limpar</button>
      </div>
      <p class="disclaimer">Isto é um guia para conversa, não um diagnóstico. Várias condições podem causar dor no mesmo lugar.</p>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-bodymap]').forEach(function (root) {
      if (root.dataset.ready) return;
      root.dataset.ready = '1';
      root.classList.add('js');
      var selected = new Set();
      var chips = root.querySelectorAll('[data-chip]');
      var regions = root.querySelectorAll('.r');
      var items = Array.prototype.slice.call(root.querySelectorAll('[data-cond]'));
      var list = root.querySelector('.list');
      var status = root.querySelector('[data-status]');
      var actions = root.querySelector('[data-actions]');
      var levar = root.querySelector('[data-levar]');
      var levarBase = levar.getAttribute('href');
      var mais = root.querySelector('[data-mais]');
      var LIMITE = 6, expandido = false;
      mais.addEventListener('click', function () { expandido = true; render(); });

      function render() {
        chips.forEach(function (c) { c.setAttribute('aria-pressed', selected.has(c.dataset.chip) ? 'true' : 'false'); });
        regions.forEach(function (g) { g.classList.toggle('on', selected.has(g.dataset.r)); });
        var scored = items.map(function (li) {
          var rs = li.dataset.regioes.split(' ');
          var s = 0; rs.forEach(function (r) { if (selected.has(r)) s++; });
          return { li: li, s: s, o: Number(li.dataset.ordem) };
        });
        if (!selected.size) {
          items.forEach(function (li) { li.hidden = true; });
          status.textContent = 'Marque uma ou mais regiões para ver condições que costumam envolvê-las.';
          actions.hidden = true;
          mais.hidden = true; expandido = false;
          return;
        }
        scored.sort(function (a, b) { return b.s - a.s || a.o - b.o; });
        var n = 0;
        scored.forEach(function (x) { if (x.s) n++; x.li.hidden = x.s === 0 || (!expandido && n > LIMITE); list.appendChild(x.li); });
        mais.hidden = expandido || n <= LIMITE;
        mais.textContent = 'Mostrar todas as ' + n + ' condições';
        status.textContent = n ? n + (n === 1 ? ' condição costuma' : ' condições costumam') + ' envolver o que você marcou:' : 'Nenhuma condição da lista envolve essa combinação — vale conversar na consulta.';
        actions.hidden = false;
        levar.setAttribute('href', levarBase + '?regioes=' + Array.from(selected).join(','));
      }
      function toggle(id) { selected.has(id) ? selected.delete(id) : selected.add(id); render(); }

      chips.forEach(function (c) { c.addEventListener('click', function () { toggle(c.dataset.chip); }); });
      regions.forEach(function (g) {
        g.addEventListener('click', function () { toggle(g.dataset.r); });
        g.addEventListener('mouseenter', function () { root.querySelectorAll('[data-r="' + g.dataset.r + '"]').forEach(function (x) { x.classList.add('hover'); }); });
        g.addEventListener('mouseleave', function () { root.querySelectorAll('.hover').forEach(function (x) { x.classList.remove('hover'); }); });
      });
      root.querySelector('[data-limpar]').addEventListener('click', function () { selected.clear(); render(); });
      render();
    });
  })();
</script>

<style>
  .bodymap { display: grid; gap: var(--space-4); align-items: start; }
  @media (min-width: 900px) { .bodymap { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); } }
  .figures { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; max-width: 460px; margin-inline: auto; }
  figure { margin: 0; text-align: center; }
  figcaption { font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-top: 0.5rem; }
  .body { width: 100%; height: auto; overflow: visible; }
  .body .r { cursor: pointer; }
  .body .r > * {
    fill: var(--surface); stroke: #bfb3a0; stroke-width: 1.2;
    transition: fill .18s ease, stroke .18s ease;
  }
  .body .r.hover > * { fill: #efe3cc; stroke: var(--gold); }
  .body .r.on > * { fill: var(--gold); stroke: #7d5d2b; }
  .hint { text-align: center; font-size: 0.85rem; color: var(--muted); margin: 0.75rem 0 0; }

  .chips { border: 0; padding: 0; margin: 0 0 var(--space-3); display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chips legend { font: 500 var(--step-1)/1.3 var(--font-serif); margin-bottom: 0.9rem; padding: 0; }
  .chip {
    font: 500 0.9rem/1.2 var(--font-sans); color: var(--ink);
    background: var(--surface); border: 1px solid var(--line); border-radius: 999px;
    padding: 0.55rem 0.9rem; min-height: 40px; cursor: pointer;
  }
  .chip:hover { border-color: var(--ink); }
  .chip[aria-pressed='true'] { background: var(--navy); color: var(--on-navy); border-color: var(--navy); }

  .status { font-weight: 600; margin-bottom: 0.75rem; }
  .bodymap:not(.js) .status { display: none; }
  .list { list-style: none; padding: 0; margin: 0; }
  .list li { border-top: 1px solid var(--line); padding: 0.9rem 0; }
  .list li:last-child { border-bottom: 1px solid var(--line); }
  .list a { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; text-decoration: none; }
  .list a:hover .c-title { text-decoration: underline; }
  .c-title { font: 500 var(--step-1)/1.25 var(--font-serif); }
  .c-type { font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
  .list p { margin: 0.3rem 0 0; color: var(--ink-soft); font-size: 0.93rem; }
  .more { margin-top: 0.75rem; background: none; border: 0; padding: 0.4rem 0; font: 600 0.92rem/1.2 var(--font-sans); color: var(--ink); text-decoration: underline; cursor: pointer; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: var(--space-3); }
  .disclaimer { font-size: 0.82rem; color: var(--muted); margin-top: var(--space-2); }
  .compacto .list li { padding: 0.7rem 0; }
</style>
