---
interface Props { itens: { nome: string; href: string }[]; }
const { itens } = Astro.props;
---
<nav class="crumbs" aria-label="Você está em">
  <ol>
    {itens.map((it, i) => (
      <li>{i < itens.length - 1 ? <a href={it.href}>{it.nome}</a> : <span aria-current="page">{it.nome}</span>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0; margin: 0 0 1.5rem; font-size: 0.88rem; color: var(--muted); }
  .crumbs li:not(:last-child)::after { content: '/'; margin-left: 0.4rem; color: var(--line); }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; color: var(--ink); }
</style>
